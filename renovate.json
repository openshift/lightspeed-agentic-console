{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "timezone": "UTC",
  "rangeStrategy": "pin",
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["major", "minor", "patch"],
      "minimumReleaseAge": "14 days",
      "schedule": ["* * * * 1,3,5"]
    },
    {
      "matchPackageNames": ["/^quay\\.io\\/konflux-ci\\//"],
      "minimumReleaseAge": "0 days",
      "schedule": ["* * * * *"],
      "addLabels": [
        "approved",
        "lgtm"
      ]
    },
    {
      "matchFileNames": ["rpms.in.yaml", "rpms.lock.yaml"],
      "addLabels": [
        "approved",
        "lgtm"
      ]
    },
    {
      "matchPackageNames": ["react", "react-dom", "react-i18next", "react-router"],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "@types/node",
        "@types/react",
        "@types/react-dom",
        "@patternfly/*",
        "eslint",
        "js-yaml",
        "vitest"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackageNames": ["node", "npm"],
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@openshift-console/dynamic-plugin-sdk", "@openshift-console/dynamic-plugin-sdk-webpack"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "groupName": "lint",
      "matchPackageNames": [
        "eslint",
        "eslint-*",
        "prettier",
        "stylelint",
        "stylelint-*",
        "typescript-eslint"
      ]
    },
    {
      "groupName": "patternfly",
      "matchPackageNames": ["@patternfly/*"]
    },
    {
      "groupName": "test",
      "matchPackageNames": ["@playwright/*", "mcr.microsoft.com/playwright"]
    }
  ]
}
